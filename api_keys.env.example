# 1) Copy this file to a new file named  api_keys.env  (start.bat does this for you).
# 2) Paste YOUR OWN keys after the = signs. No spaces, no quotes.
# 3) NEVER share api_keys.env, post it in chat, or upload it to GitHub.

# GitHub "classic" token with the public_repo permission (see README, step 3)
GITHUB_TOKEN=

# Free AI key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check the model name in Google AI Studio; change it here if a model is retired
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=

# Optional extra AI providers (leave as is if you only use Gemini)
GROQ_ENABLED=0
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CLOUDFLARE_ENABLED=0
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OPENROUTER_ENABLED=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_PROVIDER_ORDER=gemini,groq,cloudflare,ollama,openrouter
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPM=8000
GROQ_TPD=200000
GEMINI_RPM=0
GEMINI_RPD=0
GEMINI_TPM=0
GEMINI_TPD=0
AGENT_MAX_OUTPUT_TOKENS=4096
